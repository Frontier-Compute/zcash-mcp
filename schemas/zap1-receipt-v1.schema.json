{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Frontier-Compute/zcash-mcp/schemas/zap1-receipt-v1.schema.json",
  "title": "ZAP1 Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "subject_hash",
    "claim_hash",
    "evidence_hash",
    "leaf_hash",
    "merkle_root",
    "merkle_path"
  ],
  "properties": {
    "schema_version": {
      "const": "zap1-receipt-v1"
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "profile": {
      "enum": [
        "public_hash_only",
        "counterparty_receipt",
        "auditor_packet",
        "operator_internal",
        "grant_proof_packet",
        "compliance_audit_packet"
      ]
    },
    "subject_hash": {
      "$ref": "#/$defs/hex64"
    },
    "claim_hash": {
      "$ref": "#/$defs/hex64"
    },
    "evidence_hash": {
      "$ref": "#/$defs/hex64"
    },
    "leaf_hash": {
      "$ref": "#/$defs/hex64"
    },
    "merkle_root": {
      "$ref": "#/$defs/hex64"
    },
    "merkle_path": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hex64"
      }
    },
    "anchor_txid": {
      "$ref": "#/$defs/hex64"
    },
    "anchor_height": {
      "type": "integer",
      "minimum": 0
    },
    "verification_url": {
      "type": "string",
      "format": "uri"
    },
    "disclosed_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "redacted_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "redaction_policy": {
      "enum": [
        "hash_only",
        "counterparty_visible",
        "auditor_visible",
        "operator_private",
        "grant_public",
        "compliance_limited"
      ]
    },
    "status": {
      "enum": [
        "requested",
        "attested",
        "anchored",
        "verified",
        "disputed",
        "expired",
        "revoked"
      ]
    },
    "grant_context": {
      "type": "object",
      "additionalProperties": true
    },
    "audit_context": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}
