{
  "name": "@frontiercompute/zcash-mcp",
  "description": "ZAP1 receipts for Zcash agents: verify workflows without trusting the server. Attestation layer, not a wallet.",
  "version": "1.4.0",
  "transport": "stdio",
  "tools": [
    "decode_memo",
    "attest_event",
    "verify_proof",
    "get_stats",
    "get_block_height",
    "lookup_transaction",
    "get_anchor_history",
    "get_anchor_status",
    "get_events",
    "get_agent_status",
    "zap1_create_receipt_invoice",
    "zcash_identity_register",
    "zap1_prove_receipt",
    "zcash_reputation_score",
    "zap1_watch_receipt_invoice",
    "zcash_capability_manifest",
    "zcash_conformance_check",
    "zcash_receipt_template",
    "zap1_wallet_receipt_request",
    "zap1_attest_external_action",
    "zap1_verify_external_receipt",
    "zap1_extract_proof_artifact",
    "zap1_check_anchor_freshness_at_height",
    "zap1_verify_receipt_chain",
    "zap1_compare_receipt_claims",
    "zap1_audit_event_log",
    "zap1_verify_evm"
  ],
  "auth": {
    "ZAP1_API_KEY": {
      "required": "write",
      "description": "Required for attest_event. Optional for read-only tools."
    },
    "ZEBRA_RPC_URL": {
      "required": false,
      "default": "http://127.0.0.1:8232",
      "description": "Zebra RPC endpoint for chain queries."
    },
    "ZAP1_API_URL": {
      "required": false,
      "default": "https://api.frontiercompute.cash",
      "description": "ZAP1 attestation API endpoint."
    }
  },
  "repository": "https://github.com/Frontier-Compute/zcash-mcp",
  "author": "Zk-nd3r",
  "license": "MIT"
}
